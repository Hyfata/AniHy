# AniHy server 설정 — .env.example를 .env로 복사 후 실제 값 입력
# (기존 inc/db.php.inc + inc/auth.php.inc + inc/configuration.php.inc 역할 통합)

# DB (MariaDB anime_site 재사용)
DB_URL=mysql+pymysql://anime:password@127.0.0.1:3306/anime_site?charset=utf8mb4

# 서명 쿠키 시크릿 (settings 테이블 cookie_secret보다 우선). 반드시 랜덤 값으로 교체
COOKIE_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# 접근 코드 게이트 폴리백 (settings.access_code가 없을 때만 사용; 기본은 DB 우선)
ACCESS_CODE_FALLBACK=

# 프로젝트 루트 (animes/ covers/ subtitles/ logs/ 등의 부모). 기본: server/의 상위 디렉터리
BASE_DIR=

# Keycloak OIDC (플레이스홀더 — 실제 Keycloak 구축 후 입력. 비어 있으면 /api/auth/login은 501)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:8000/api/auth/callback

# 인코딩 설정 (기존 inc/configuration.php)
ENCODER=software
MAX_WORKERS=1
VAAPI_DEVICE=/dev/dri/renderD128
QUALITY=23

# 서버 파일 소스 루트 (기존 api/list_server_files.php의 하드코딩)
ANIDOWN_SERVER_FILES_ROOT=/var/lib/transmission-daemon/downloads

# /api/files 공개 URL 프리픽스 — 사이트를 /anime 서브경로로 서빙(Apache 프록시)할 때만 변경
# PUBLIC_FILES_PREFIX=/anime/api/files
