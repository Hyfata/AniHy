{
  "name": "anihy-native",
  "version": "0.1.0",
  "private": true,
  "description": "AniHy Capacitor wrapper (iOS/Android). Server URL lives only in capacitor.config.ts (gitignored).",
  "scripts": {
    "vendor:sync": "bash scripts/sync-vendor.sh",
    "cap": "cap",
    "sync": "npm run vendor:sync && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.1",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/ios": "^7.4.3",
    "@capacitor/preferences": "^7.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
