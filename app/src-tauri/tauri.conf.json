{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniHy",
  "version": "0.1.0",
  "identifier": "kr.hyfata.anime",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "AniHy",
        "label": "main",
        "width": 430,
        "height": 860,
        "resizable": true,
        "backgroundColor": "#0b0c0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
